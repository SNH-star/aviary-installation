FROM ubuntu:24.04

# Install dependencies
RUN apt-get update \
    && apt-get install -y build-essential wget curl git python3-venv \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Use a venv rather than the apt-managed system pip/python, whose pip install
# is missing a RECORD file and can't be upgraded (aviary-genome pins pip==25.3)
RUN python3 -m venv /opt/aviary-venv
ENV PATH=/opt/aviary-venv/bin:$PATH

# Install aviary and its Python dependencies via pip (matches docs Option 2's final step)
RUN pip install aviary-genome==AVIARY_VERSION

# aviary imports bird_tool_utils at runtime but aviary-genome's PyPI metadata
# doesn't declare it as a dependency, so it must be installed separately
RUN pip install bird-tool-utils

# Install miniconda (needed for the non-python binaries below, and as a pixi prerequisite)
ENV CONDA_DIR /opt/conda

RUN wget --quiet https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O ~/miniconda.sh && \
    /bin/bash ~/miniconda.sh -b -p /opt/conda

# Put conda in path so we can use conda activate
ENV PATH=$CONDA_DIR/bin:$PATH

# Install pixi (required for aviary sub-environments)
RUN curl -fsSL https://pixi.sh/install.sh | bash && \
    ln -s /root/.pixi/bin/pixi /usr/local/bin/pixi

# Accept conda Terms of Service
RUN conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main && \
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r

# Install the non-python system binaries aviary needs, unpinned so conda can pick
# whatever mutually-compatible versions are current (mirrors the singlem-installation pattern)
RUN conda create -y -c conda-forge -c bioconda -n aviary \
    parallel \
    pigz

# activate the aviary environment and ensure pixi is in PATH
RUN echo "source activate aviary" > ~/.bashrc
ENV PATH=$CONDA_DIR/envs/aviary/bin:/root/.pixi/bin:$CONDA_DIR/bin:$PATH

# Download some example data so we can test the installation
RUN wget https://github.com/rhysnewell/aviary/raw/main/test/data/wgsim.1.fq.gz
RUN wget https://github.com/rhysnewell/aviary/raw/main/test/data/wgsim.2.fq.gz

# Build aviary pixi sub-environments
RUN aviary build

# Set required database paths to arbitrary values since we're only testing assemble and they are not baked in
ENV GTDBTK_DATA_PATH=/tmp \
    EGGNOG_DATA_DIR=/tmp \
    METABULI_DB_PATH=/tmp \
    SINGLEM_METAPACKAGE_PATH=/tmp \
    CHECKM2DB=/tmp \
    CHECKM_DATA_PATH=/tmp

# Run aviary assemble with megahit on the test reads
RUN aviary assemble \
    -1 wgsim.1.fq.gz \
    -2 wgsim.2.fq.gz \
    --use-megahit \
    --skip-qc \
    -o aviary_test_out \
    -n 4 -t 4
